# Inhouse AI environment template. Copy to .env and replace every placeholder.
# Generate secrets with: openssl rand -hex 32

WEBUI_NAME=Inhouse AI
WEBUI_SECRET_KEY=replace-with-a-random-secret

POSTGRES_USER=inhouse_ai_user
POSTGRES_PASSWORD=replace-with-a-random-password
POSTGRES_DB=inhouse_ai_db

# Must start with "sk-"
LITELLM_MASTER_KEY=sk-replace-with-a-random-key

# Keep model names in sync with litellm/config.yaml.
CHAT_MODEL=qwen3:4b-instruct
EMBED_MODEL=nomic-embed-text

# Cloudflare Zero Trust -> Networks -> Tunnels -> create tunnel -> copy the token.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-your-cloudflare-tunnel-token
